{
	"dataset": {
		"data_division": 0.8,
		"load_from_file": false,
		"path": "data/finemix/"
	},
	"checkpoints": {
		"path": "bin/5M/128b/c2",
		"interval": 2000,
		"create_checkpoints": true
	},
	"model_hyperparams": {
		"vocab_size": 8192,
		"block_size": 128,
		"n_layer": 8,
		"n_head": 8,
		"n_embd": 64,
		"d_model": 256
	},
	"optimizer_hyperparams": {
		"eps": 1e-8,
		"beta1": 0.9,
		"beta2": 0.95,
		"momentum": 0.95,
		"weight_decay": 1e-3
	},
	"encoder_path": "bin/o8k.bin",
	"init_from": "scratch",
	"compile": true,
	"seed": 18,

	"batch_size": 16,
	"gradient_accumulation_steps": 4,

	"eval_iters": 200,
	"max_iters": 125000,
	"log_interval": 200,
	"eval_interval": 2000,

	"decay_lr": true,
	"warmup_iters": 6250,
	"cooldown_frac": 0.4,
	"learning_rate": 8e-4,
	"lr_decay_iters": 125000,
	"min_learning_rate": 8e-5
}
